# ---- Server ----
PORT=4000
# Comma-separated list of frontend origins allowed to call this API (no trailing slash).
# `*` works as a wildcard, e.g. https://rock-n-logs-*.vercel.app for Vercel preview URLs.
# Local: http://localhost:3000   Production: your Vercel URL, e.g. https://rock-n-logs.vercel.app
FRONTEND_URL="http://localhost:3000"

# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ---- Admin auth ----
# The API creates this admin on every boot (and syncs the password if you change it here).
# Email is stored lowercase. Password must be 8+ characters.
# Generate with: openssl rand -base64 32
ADMIN_JWT_SECRET="change-me-to-a-long-random-string"
ADMIN_SEED_EMAIL="admin@rocknlogs.com"
ADMIN_SEED_PASSWORD="choose-a-strong-password"

# ---- Restaurant details (used only by the seed script) ----
RESTAURANT_NAME="Rock n Logs"
RESTAURANT_TAGLINE="Cooking the way our neighborhood eats."
RESTAURANT_DESCRIPTION=""
RESTAURANT_ADDRESS="118 Elm Street"
RESTAURANT_PHONE="(555) 019-2244"
RESTAURANT_EMAIL="hello@rocknlogs.example"
RESTAURANT_HOURS="Tue–Sun, 5pm–11pm"

# ---- Image / PDF storage (optional — falls back to mock data-URL storage) ----
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---- WhatsApp notifications (optional — falls back to console logging) ----
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
WHATSAPP_FROM_NUMBER=""
RESTAURANT_NOTIFICATION_NUMBER=""
